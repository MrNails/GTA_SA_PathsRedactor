<Window x:Class="GTA_SA_PathsRedactor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:services="clr-namespace:GTA_SA_PathsRedactor.Services"
        xmlns:userControls="clr-namespace:GTA_SA_PathsRedactor.View.UserControls"
        xmlns:viewModel="clr-namespace:GTA_SA_PathsRedactor.ViewModel"
        mc:Ignorable="d"
        d:DesignWidth="600"
        d:DesignHeight="600"
        d:DataContext="{d:DesignInstance viewModel:MainViewModel}"
        MinWidth="800"
        MinHeight="600 "
        Title="Main window" 
        Loaded="MainWindow_OnLoaded">
    <Window.InputBindings>
        <!--<KeyBinding Key="Delete" Command="{Binding DefaultCommands.DeleteSelectedPoints, Mode=OneWay}"/>-->
        <KeyBinding Modifiers="Control" Key="L" Command="{Binding LoadPathCommand, Mode=OneWay}"/>
        <KeyBinding Modifiers="Control" Key="S" Command="{Binding SaveCurrentPathCommand, Mode=OneWay}"/>
        <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveCurrentPathAsCommand, Mode=OneWay}" />
        <KeyBinding Modifiers="Control" Key="Z" Command="{Binding Path=HistoryController.UndoCommand, Source={StaticResource Locator}, Mode=OneWay}"/>
        <KeyBinding Modifiers="Control" Key="Y" Command="{Binding Path=HistoryController.RedoCommand, Source={StaticResource Locator}, Mode=OneWay}"/>
        <KeyBinding Key="F1" Command="{Binding OpenHelpWindowCommand, Mode=OneWay}"/>
    </Window.InputBindings>
    <DockPanel LastChildFill="True">
        <StatusBar DockPanel.Dock="Bottom" Panel.ZIndex="3">
            <StatusBarItem x:Name="CurrentPathInfo" 
                           MaxWidth="150" 
                           HorizontalAlignment="Left" 
                           MinHeight="23"/>
        </StatusBar>
        <Menu DockPanel.Dock="Top" 
              FontSize="15">
            <MenuItem Header="File">
                <MenuItem Header="Load" 
                          Command="{Binding Path=LoadPathCommand, Mode=OneWay}" 
                          InputGestureText="Ctrl + L"/>
                <MenuItem Header="Save" 
                          Command="{Binding Path=SaveCurrentPathCommand, Mode=OneWay}" 
                          InputGestureText="Ctrl + S"/>
                <MenuItem Header="Save as"
                          Command="{Binding Path=SaveCurrentPathAsCommand, Mode=OneWay}" 
                          InputGestureText="Ctrl + Shift + S"/>
            </MenuItem>
            <MenuItem Header="Settings">
                <MenuItem Header="Path transform settings" 
                          Command="{Binding Path=PageContainerService.NavigateToPageCommand, Source={StaticResource Locator}, Mode=OneWay}"
                          CommandParameter="{x:Static services:Constants.PathSettingsPageName_}" />
                <MenuItem Header="Loaders and savers information" />
            </MenuItem>
            <MenuItem Header="Commands">
                <!--<MenuItem Header="Delete selected points" 
                          Command="services:DefaultCommands.DeleteSelectedPoints" 
                          InputGestureText="Del"/>-->
                <MenuItem Header="Undo" 
                          InputGestureText="Ctrl + Z" 
                          Command="{Binding Path=HistoryController.UndoCommand, Source={StaticResource Locator}, Mode=OneWay}"/>
                <MenuItem Header="Redo" 
                          InputGestureText="Ctrl + Y" 
                          Command="{Binding Path=HistoryController.RedoCommand, Source={StaticResource Locator}, Mode=OneWay}"/>
            </MenuItem>
            <MenuItem Header="Windows">
                <MenuItem Header="Help" 
                          Command="{Binding OpenHelpWindowCommand, Mode=OneWay}" 
                          InputGestureText="F1"/>
                <MenuItem Header="About" 
                          Command="{Binding OpenAboutWindowCommand, Mode=OneWay}"/>
            </MenuItem>
        </Menu>
        <ScrollViewer DockPanel.Dock="Left" 
                      VerticalScrollBarVisibility="Auto">
            <Border x:Name="UserContentContainer" 
                    Margin="-2 0 0 0"
                    BorderBrush="Black" 
                    BorderThickness="2" 
                    Width="200" 
                    Background="Gray">
                <ContentPresenter Content="{Binding Path=PageContainerService.CurrentPage, Source={StaticResource Locator}, Mode=OneWay}" />
            </Border>
        </ScrollViewer>

        <userControls:PathManipulatorUserControl ImagePath="/Resource/MapImage.jpg"
                                                 DataContext="{Binding CurrentPath, Mode=OneWay}"/>
    </DockPanel>
</Window>
