<UserControl x:Class="GTA_SA_PathsRedactor.View.UserControls.PathManipulatorUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:services="clr-namespace:GTA_SA_PathsRedactor.Services"
             xmlns:viewModel="clr-namespace:GTA_SA_PathsRedactor.ViewModel"
             mc:Ignorable="d"
             d:DesignHeight="300" 
             d:DesignWidth="300"
             d:DataContext="{viewModel:PathEditorViewModel}"
             x:Name="Root"
             ClipToBounds="True"
             PreviewMouseWheel="PathManipulatorUserControl_OnPreviewMouseWheel"
             PreviewMouseDown="PathManipulatorUserControl_OnPreviewMouseDown"
             PreviewMouseMove="PathManipulatorUserControl_OnPreviewMouseMove"
             PreviewMouseUp="PathManipulatorUserControl_OnPreviewMouseUp"
             SizeChanged="PathManipulatorUserControl_OnSizeChanged">
    <Grid x:Name="RenderGrid" 
          RenderTransformOrigin="0.5, 0.5">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform ScaleX="1" ScaleY="1" />
                <TranslateTransform X="0" Y="0" />
            </TransformGroup>
        </Grid.RenderTransform>
        
        <Image x:Name="MapIcon" 
               Stretch="Fill"
               Source="{Binding ElementName=Root, Path=ImagePath, Mode=OneWay}"/>
        <Canvas x:Name="MapContainer">
            <TextBlock x:Name="DebugTextBlock" FontSize="18" Foreground="White" />
            <Canvas.ContextMenu>
                <ContextMenu Name="CanvasContextMenu">
                    <MenuItem Header="Add point" />
                    <MenuItem Header="Clear selection" />
                </ContextMenu>
            </Canvas.ContextMenu>
        </Canvas>
    </Grid>

</UserControl>