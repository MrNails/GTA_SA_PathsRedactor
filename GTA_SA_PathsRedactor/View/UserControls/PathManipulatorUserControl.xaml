<UserControl x:Class="GTA_SA_PathsRedactor.View.UserControls.PathManipulatorUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:services="clr-namespace:GTA_SA_PathsRedactor.Services"
             xmlns:viewModel="clr-namespace:GTA_SA_PathsRedactor.ViewModel"
             xmlns:controls="clr-namespace:GTA_SA_PathsRedactor.Controls"
             mc:Ignorable="d"
             d:DesignHeight="300" 
             d:DesignWidth="300"
             d:DataContext="{viewModel:PathEditorViewModel}"
             x:Name="Root"
             ClipToBounds="True"
             MouseWheel="PathManipulatorUserControl_OnMouseWheel"
             MouseDown="PathManipulatorUserControl_OnMouseDown"
             MouseMove="PathManipulatorUserControl_OnMouseMove"
             MouseUp="PathManipulatorUserControl_OnMouseUp"
             MouseLeave="PathManipulatorUserControl_OnMouseLeave"
             PreviewMouseDown="PathManipulatorUserControl_OnPreviewMouseDown"
             PreviewMouseMove="PathManipulatorUserControl_OnPreviewMouseMove"
             PreviewMouseUp="PathManipulatorUserControl_OnPreviewMouseUp"
             SizeChanged="PathManipulatorUserControl_OnSizeChanged">
    <UserControl.Resources>
        <services:BindingProxy x:Key="RootProxy" Data="{Binding ElementName=Root, Mode=OneWay}"/>
    </UserControl.Resources>
    <Grid x:Name="RenderGrid" 
          RenderTransformOrigin="0.5, 0.5">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform ScaleX="1" ScaleY="1" />
                <TranslateTransform X="0" Y="0" />
            </TransformGroup>
        </Grid.RenderTransform>
        
        <Image x:Name="MapIcon" 
               Stretch="Fill"
               Source="{Binding ElementName=Root, Path=ImagePath, Mode=OneWay}">
            <Image.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Add point" 
                              Click="AddPointMenuItem_OnClick"/>
                    <MenuItem Header="Clear selection" 
                              Command="{Binding Data.DataContext.ClearSelectionCommand, 
                                                Mode=OneWay, 
                                                Source={StaticResource RootProxy}}"/>
                </ContextMenu>
            </Image.ContextMenu>
        </Image>
        
        <Rectangle x:Name="SelectionRectangle" 
                   StrokeThickness="2"
                   StrokeDashArray="3 2"
                   Stroke="Black"
                   Visibility="Visible"
                   VerticalAlignment="Top"
                   HorizontalAlignment="Left">
            <Rectangle.RenderTransform>
                <TranslateTransform />
            </Rectangle.RenderTransform>
        </Rectangle>
        
        <controls:PathManipulator x:Name="MapContainer" 
                                  PointsToDisplay="{Binding Points, Mode=OneWay}"
                                  PointsColor="{Binding Color, Mode=OneWay}"
                                  SelectedPoint="{Binding SelectedPoint, Mode=TwoWay}"
                                  StopPointPointsColor="Coral"
                                  PointRadius="2">
            <controls:PathManipulator.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Insert point" 
                              Click="InsertPointMenuItem_OnClick"/>
                    <MenuItem Header="Remove point" 
                              Command="{Binding Data.DataContext.RemovePointCommand, 
                                                Mode=OneWay,
                                                Source={StaticResource RootProxy}}"
                              CommandParameter="{Binding Data.DataContext.SelectedPoint, 
                                                          Mode=OneWay,
                                                          Source={StaticResource RootProxy}}"/>
                    <MenuItem Header="Clear selection" 
                              Command="{Binding Data.DataContext.ClearSelectionCommand, 
                                                Mode=OneWay, 
                                                Source={StaticResource RootProxy}}"/>
                </ContextMenu>
            </controls:PathManipulator.ContextMenu>
        </controls:PathManipulator>
    </Grid>

</UserControl>