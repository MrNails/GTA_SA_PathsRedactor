<UserControl x:Class="GTA_SA_PathsRedactor.View.PointTransformationUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GTA_SA_PathsRedactor.View"
             xmlns:services="clr-namespace:GTA_SA_PathsRedactor.Services"
             xmlns:userControls="clr-namespace:GTA_SA_PathsRedactor.View.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="200">
    <UserControl.Resources>
        <Style TargetType="{x:Type TextBox}" 
               BasedOn="{StaticResource ResourceKey=TextBoxValidationTemplate}">
            <Setter Property="FontSize" Value="18"/>
        </Style>
        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="Margin" Value="10 5 10 5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="{x:Type Button}">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10 2 10 2"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Background" Value="LightGray"/>
        </Style>

        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Margin" Value="0 0 0 3"/>
        </Style>
        
    </UserControl.Resources>
    <Grid Background="Gray">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    DataContext="{Binding PointTransformationData}"
                    d:DataContext="{d:DesignInstance services:PointTransformationData}">
            <StackPanel Margin="10">
                <TextBlock Text="OffsetX" />
                <userControls:NumericUpDown Value="{Binding OffsetX, Mode=TwoWay}"/>
            </StackPanel>
            <StackPanel Margin="10">
                <TextBlock Text="OffsetY"/>
                <userControls:NumericUpDown Value="{Binding OffsetY, Mode=TwoWay}"/>
            </StackPanel>
            <StackPanel Margin="10">
                <TextBlock Text="ScaleX"/>
                <userControls:NumericUpDown Value="{Binding PointScaleX, Mode=TwoWay}"/>
            </StackPanel>
            <StackPanel Margin="10">
                <TextBlock Text="ScaleY"/>
                <userControls:NumericUpDown Value="{Binding PointScaleY, Mode=TwoWay}"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <Button Content="Load settings" 
                    Command="{Binding Path=LoadSettingsCommand, Mode=OneWay}"/>
            <Button Content="Save settings" 
                    Command="{Binding Path=SaveSettingsCommand, Mode=OneWay}"/>
        </StackPanel>

        <Button Grid.Row="2" 
                VerticalAlignment="Bottom"
                Content="Go to main menu" 
                Command="{Binding Path=PageContainerService.NavigatToPageCommand, Source={StaticResource Locator}, Mode=OneWay}"
                CommandParameter="{x:Static services:Constants.MainPageName_}"/>
    </Grid>
</UserControl>
